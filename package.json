{
	"name": "meetup-event-automation",
	"description": "Meetup event journey automation actions and reusable workflows",
	"version": "1.0.0",
	"author": "Cloud Native Aix-Marseille",
	"type": "module",
	"private": true,
	"packageManager": "pnpm@11.25.0",
	"homepage": "https://github.com/cloud-native-aixmarseille/meetup-event-automation",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/cloud-native-aixmarseille/meetup-event-automation.git"
	},
	"bugs": {
		"url": "https://github.com/cloud-native-aixmarseille/meetup-event-automation/issues"
	},
	"keywords": [
		"actions",
		"meetup",
		"issue",
		"linter"
	],
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"package": "node scripts/build-actions.mjs",
		"lint:biome": "biome lint --error-on-warnings .",
		"lint": "pnpm format:check && pnpm lint:biome && pnpm check:structure && pnpm check:knip",
		"lint:fix": "pnpm lint:biome --fix",
		"lint:ci": "biome lint --error-on-warnings . --reporter=sarif > biome-report.sarif && pnpm format:check && pnpm check:structure",
		"check:architecture": "vitest run tests/architecture.spec.ts",
		"check:contracts": "vitest run tests/contracts",
		"check:knip": "knip",
		"quality": "pnpm lint && pnpm build && pnpm check:architecture && pnpm check:contracts && pnpm package && pnpm test && pnpm check:dist",
		"all": "pnpm format && pnpm quality",
		"build": "tsc --noEmit -p tsconfig.json",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:cov": "vitest run --coverage",
		"test:ci": "vitest run --reporter=default --reporter=junit --outputFile=junit.xml --coverage.enabled --coverage.reporter=lcov --coverage.reporter=text",
		"nx": "nx",
		"workspace:build": "nx run-many -t typecheck",
		"workspace:test": "nx run-many -t test",
		"check:dist": "node scripts/check-dist.mjs",
		"check": "biome check --error-on-warnings --write .",
		"vitest": "vitest",
		"check:structure": "node scripts/check-code-structure.mjs"
	},
	"license": "MIT",
	"devDependencies": {
		"@babel/parser": "^8.0.7",
		"@biomejs/biome": "^2.5.15",
		"@commitlint/config-conventional": "21.2.3",
		"@types/node": "^26.6.4",
		"@vitest/coverage-v8": "5.0.3",
		"archunit": "2.5.4",
		"esbuild": "^0.28.2",
		"knip": "6.39.0",
		"nx": "^23.3.0",
		"typescript": "^7.0.2",
		"vitest": "5.0.3",
		"yaml": "^2.9.1"
	},
	"commitlint": {
		"extends": [
			"@commitlint/config-conventional"
		]
	}
}
