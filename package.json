{
	"name": "meetup-event-automation",
	"description": "Meetup event journey automation actions and reusable workflows",
	"version": "1.0.0",
	"author": "Cloud Native Aix-Marseille",
	"type": "module",
	"private": true,
	"packageManager": "pnpm@11.25.0",
	"homepage": "https://github.com/cloud-native-aixmarseille/meetup-issue-linter-action",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/cloud-native-aixmarseille/meetup-issue-linter-action.git"
	},
	"bugs": {
		"url": "https://github.com/cloud-native-aixmarseille/meetup-issue-linter-action/issues"
	},
	"keywords": [
		"actions",
		"meetup",
		"issue",
		"linter"
	],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"package": "node scripts/build-actions.mjs",
		"lint:biome": "biome lint --error-on-warnings .",
		"lint": "corepack pnpm lint:biome && corepack pnpm check:knip",
		"lint:fix": "corepack pnpm lint:biome --fix",
		"lint:ci": "biome lint --error-on-warnings . --reporter=sarif | tee biome-report.sarif",
		"check:architecture": "vitest run tests/architecture.spec.ts",
		"check:contracts": "vitest run tests/contracts.spec.ts",
		"check:knip": "knip",
		"quality": "corepack pnpm lint && corepack pnpm build && corepack pnpm check:architecture && corepack pnpm check:contracts && corepack pnpm package && corepack pnpm test && corepack pnpm check:dist",
		"all": "corepack pnpm format && corepack pnpm quality",
		"build": "tsc --noEmit -p tsconfig.json",
		"format": "biome format --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:cov": "vitest run --coverage",
		"test:ci": "vitest run --reporter=default --reporter=junit --outputFile=junit.xml --coverage.enabled --coverage.reporter=lcov --coverage.reporter=text",
		"nx": "nx",
		"workspace:build": "nx run-many -t typecheck",
		"workspace:test": "nx run-many -t test",
		"check:dist": "node scripts/check-dist.mjs",
		"check": "biome check --error-on-warnings --write .",
		"vitest": "vitest"
	},
	"license": "MIT",
	"dependencies": {
		"@actions/github": "^9.1.1",
		"@meetup-automation/event": "workspace:*",
		"@meetup-automation/publication": "workspace:*",
		"inversify": "^8.2.3",
		"reflect-metadata": "^0.2.2"
	},
	"devDependencies": {
		"@actions/core": "^3.0.1",
		"@biomejs/biome": "^2.4.3",
		"@commitlint/config-conventional": "20.0.0",
		"@types/node": "^26.4.1",
		"@vitest/coverage-v8": "4.1.10",
		"archunit": "2.4.0",
		"esbuild": "^0.28.2",
		"knip": "6.35.1",
		"nx": "^23.2.0",
		"typescript": "^6.0.3",
		"vitest": "4.1.10",
		"yaml": "^2.9.0"
	},
	"commitlint": {
		"extends": [
			"@commitlint/config-conventional"
		]
	}
}
