{
	"name": "journey",
	"projectType": "library",
	"sourceRoot": "packages/application/journey/src",
	"targets": {
		"typecheck": {
			"executor": "nx:run-commands",
			"options": {
				"command": "tsc --noEmit -p packages/application/journey/tsconfig.lib.json"
			}
